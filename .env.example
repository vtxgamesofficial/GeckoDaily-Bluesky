# ── Bluesky account the bot posts as ─────────────────────────────────
# Create an App Password at https://bsky.app/settings/app-passwords
# Do NOT use your real account password here.
BLUESKY_IDENTIFIER=geckodaily.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Cloudflare Workers AI ─────────────────────────────────────────────
# NOT used by the posting flow anymore — posts now use the "quick answer"
# text already on the GeckoDaily site (no AI rewriting step, no extra API
# calls). These are only kept here in case you re-enable AI rewriting
# later; safe to leave blank.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# ── GeckoDaily site the bot promotes ──────────────────────────────────
SITE_BASE_URL=https://geckodaily.vercel.app

# ── Posting schedule (only used by `npm run schedule`, i.e. long-running mode) ──
# Cron syntax, evaluated in TZ below. Default: 09:00, 14:00, 19:00 daily.
POST_CRON=0 9,14,19 * * *
TZ=Europe/London

# ── Optional: safe engagement (liking on-topic posts). OFF by default. ──
ENGAGE_ENABLED=false
ENGAGE_MAX_LIKES=5
# Cron for engagement pass if run via `npm run schedule` (every 3 hours by default)
ENGAGE_CRON=0 */3 * * *

# ── Misc ──
LOG_LEVEL=info
